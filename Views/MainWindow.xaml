<Window x:Class="TableForGto.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TableForGto"
        xmlns:vm="clr-namespace:TableForGto.ViewModels"
        xmlns:commands="clr-namespace:TableForGto.Commands"
        mc:Ignorable="d"
        Title="TableForGto" 
        Height="900" Width="1600"
        FontSize="{StaticResource fs-base}"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        ThemeMode="Light"
        Icon="/Assets/Images/MainWindowIcon.ico">
    <Window.CommandBindings>
        <CommandBinding Command="New" Executed="NewExecuted" />
        <CommandBinding Command="Open" Executed="OpenExecuted" />
        <CommandBinding Command="Close" Executed="CloseExecuted" />
        <CommandBinding Command="{x:Static commands:MenuCommands.AddColumnCommand}"
                        Executed="AddColumnExecuted" />
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="F4" Modifiers="Alt" Command="Close" />
        <KeyBinding Key="F5" Command="{Binding SelectedTable.SetRatingCommand}" />
    </Window.InputBindings>
    <DockPanel Margin="5">
        <!--Top menu-->
        <Menu DockPanel.Dock="Top">
            <Menu.Resources>
                <Style TargetType="Image">
                    <Setter Property="Width" Value="24" />
                    <Setter Property="Height" Value="24" />
                </Style>
            </Menu.Resources>
            <MenuItem Header="Файл">
                <MenuItem Header="Новый проект" Command="New">
                    <MenuItem.Icon>
                        <Image Source="/Assets/Images/Menu/NewProject.png" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Открыть" Command="Open">
                    <MenuItem.Icon>
                        <Image Source="/Assets/Images/Menu/OpenProject.png" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Сохранить" 
                          Command="{Binding SaveCommand}" 
                          InputGestureText="Ctrl+S">
                    <MenuItem.Icon>
                        <Image Source="/Assets/Images/Menu/SaveProject.png" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Закрыть" Command="Close" InputGestureText="Aft+F4">
                    <MenuItem.Icon>
                        <Image Source="/Assets/Images/Menu/ExitApp.png" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="Правка">
                <MenuItem Header="Копировать" Command="Copy">
                    <MenuItem.Icon>
                        <Image Source="/Assets/Images/Menu/Copy.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Вырезать" Command="Cut">
                    <MenuItem.Icon>
                        <Image Source="/Assets/Images/Menu/Cut.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Вставить" Command="Paste">
                    <MenuItem.Icon>
                        <Image Source="/Assets/Images/Menu/Paste.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Выделить все" Command="SelectAll">
                    <MenuItem.Icon>
                        <Image Source="/Assets/Images/Menu/SelectAll.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Удалить">
                    <MenuItem.Icon>
                        <Image Source="/Assets/Images/Menu/Delete.png"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="Вставка">
                <MenuItem Command="{x:Static commands:MenuCommands.AddColumnCommand}">
                    <MenuItem.Icon>
                        <Image Source="/Assets/Images/Menu/Column.png"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="Рейтинг">
                <MenuItem Header="Составить" 
                          Command="{Binding SelectedTable.SetRatingCommand}"
                          InputGestureText="F5">
                    <MenuItem.Icon>
                        <Image Source="/Assets/Images/Menu/Rating.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Очистить" Command="{Binding SelectedTable.ClearRatingCommand}">
                    <MenuItem.Icon>
                        <Image Source="/Assets/Images/Menu/Clear.png"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>
        <!--Table title-->
        <TextBlock DockPanel.Dock="Top"
                   DataContext="{Binding SelectedTable}"
                   Text="{Binding Title}"
                   HorizontalAlignment="Center"
                   Margin="0 5 0 5"
                   FontSize="{StaticResource fs1}"/>
        <!--Table control-->
        <DockPanel DockPanel.Dock="Bottom" Background="{DynamicResource ListBoxBackground}">
            <!--Add button-->
            <Button DockPanel.Dock="Left"
                    Command="{Binding AddTableCommand}"
                    Style="{DynamicResource AccentButtonStyle}"
                    Margin="0 0 0 10"
                    Height="50">
                <Image Source="/Assets/Images/Add.png" Width="24" Height="24" />
            </Button>
            <!--Tables list-->
            <ListBox Grid.Row="2" Grid.Column="1"
                     ItemsSource="{Binding Tables}"
                     SelectedItem="{Binding SelectedTable}"
                     Name="tableList">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Margin="0 0 0 10" Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title}"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   Width="150"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
        <!--Table-->
        <DataGrid DataContext="{Binding SelectedTable}"
                  ItemsSource="{Binding Students}"
                  Name="_dataGrid"
                  AutoGenerateColumns="False"
                  AddingNewItem="OnAddStudent"
                  ColumnDisplayIndexChanged="OnColumnIndexChanged"
                  DataContextChanged="OnTableChanged"
                  SelectionUnit="Cell"
                  Margin="0 5 0 5" />
    </DockPanel>
</Window>
